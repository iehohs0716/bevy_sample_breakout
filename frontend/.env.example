# OAuthサンドボックス検証用（pages/oauth-sandbox）。
# 本番の自前APIレイヤー(worker/)経由の呼び出しには使わない。認証専用の例外
# (doc_arch/frontend.md §3) として Supabase Auth の JS SDK を直接使うためだけの設定。

# api-gw（Envoy、ルートの docker-compose.yml 参照）経由での Supabase Auth のURL。
VITE_SUPABASE_URL=http://localhost:8000

# ルートの .env の ANON_KEY と同じ値をコピーする。
VITE_SUPABASE_ANON_KEY=
