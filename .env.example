# Supabase 公式セルフホストのフルスタック構成（db, rest, auth, api-gw(Envoy), realtime,
# storage, imgproxy, meta, studio, functions, supavisor の11サービス）向けの環境変数。
# 本番では Realtime / Edge Functions / Supavisor は使わない方針（doc_arch/backend.md 参照）
# だが、ローカル環境は学習・検証目的でこれらも含めてフルスタックを再現する。
#
# ローカル専用のデモ用シークレット（Supabase公式のセルフホスティングクイックスタートが
# 公開している値と同じ）。これらはローカル開発以外（本番公開やインターネット上への公開）
# では絶対に使い回さないこと。

############
# Postgres
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

############
# JWT / PostgREST
############

JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# anon / service_role の API キー（PostgREST の apikey ヘッダに使う）。
# 上記 JWT_SECRET で署名されたローカル専用デモ値。
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q


# graphql_public は含めない: このプロジェクトは GraphQL を使わず、
# 対応する初期化スクリプト（graphql_public スキーマ作成）も db 側に用意していないため、
# 含めるとまっさらな volume からの起動時に PostgREST がスキーマキャッシュ読み込みに
# 失敗し続けて unhealthy から回復しない。
PGRST_DB_SCHEMAS=public

############
# Auth (GoTrue) / Google OAuth サンドボックス検証用
############

# フロント（Vite dev server）のURL。OAuth完了後の戻り先の許可リストに使う。
SITE_URL=http://localhost:5173
ADDITIONAL_REDIRECT_URLS=http://localhost:5173/oauth-sandbox

# api-gw（Envoy）経由での GoTrue の外部公開URL。JWTのiss claimにもそのまま使われる。
API_EXTERNAL_URL=http://localhost:8000/auth/v1

# Google Cloud Console で発行する OAuth クライアント（手順は
# docs_bevy_sample/20260816_google-oauth-client-setup-for-local-gotrue.md を参照）。
# 発行するまでは GOOGLE_ENABLED=false のままにしておく（クライアントID未設定でtrueにすると
# GoTrue が起動時にエラーになる）。
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

############
# API Gateway (Envoy) / URL
############

# Envoy(api-gw)が外部に公開するURL。Studio・Storage・Functionsが内部でこの値を参照する。
SUPABASE_PUBLIC_URL=http://localhost:8000
# ホスト側で公開するポート。
API_GW_HTTP_PORT=8000
# Envoy経由のStudioダッシュボードへのBasic認証。
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated

############
# Realtime / Supavisor 共通の暗号化キー
############

# Realtime・Supavisorの内部トークン署名キー（64文字以上。openssl rand -base64 48）
SECRET_KEY_BASE=your-secret-key-base-at-least-64-characters-long-please-change-me
# Realtimeが_realtimeスキーマ内の機微情報を暗号化する鍵（openssl rand -hex 16）
REALTIME_DB_ENC_KEY=supabaserealtime
# Supavisorが設定情報を暗号化する鍵（32文字。openssl rand -hex 16）
VAULT_ENC_KEY=your-32-character-encryption-key

############
# postgres-meta / Studio
############

# Studio↔postgres-meta間の接続文字列暗号化鍵（32文字以上。openssl rand -base64 24）
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min
STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project
# AI Assistant機能は今回使わないため空のままでよい
OPENAI_API_KEY=

############
# Storage / imgproxy
############

# ファイルバックエンド使用時はディレクトリ名として使われる（S3バックエンドは今回使わない）
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
# StorageのS3互換プロトコルエンドポイント用（今回は未使用だが環境変数参照があるため設定）
S3_PROTOCOL_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
S3_PROTOCOL_ACCESS_KEY_SECRET=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907
IMGPROXY_AUTO_WEBP=true

############
# Functions
############

# 検証目的でJWT検証を無効化（有効化する場合は関数呼び出し時にAuthorizationヘッダが必須になる）
FUNCTIONS_VERIFY_JWT=false

############
# Supavisor（DBプーラー。学習・検証目的でのみ追加。rest/authの接続経路には使わない）
############

POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=your-tenant-id
POOLER_DB_POOL_SIZE=5
